rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // USER DATA: /users/{userId}
    // Users can only access their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // PUBLIC COLLECTIONS: Teams, Players
    // Allow public read for all.
    // Allow writes only for signed-in users.
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // LEAGUES: Nested Collections
    // Public read for all, writes for signed-in users.
    match /leagues/{leagueId}/{documents=**} {
        allow read: if true;
        allow write: if isSignedIn();
    }
    
    // CUPS: Nested Collections
    // Public read for all, writes for signed-in users.
    match /cups/{cupId}/{documents=**} {
        allow read: if true;
        allow write: if isSignedIn();
    }
  }
}
