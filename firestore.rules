rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * This ruleset implements a hybrid security model designed for a sports tournament application.
     * 1. User-Ownership: Personal profile data is strictly isolated to the authenticated owner.
     * 2. Administrative Control: Game-related data (Teams, Leagues, Cups, Matches) is publicly 
     *    viewable but can only be modified by users whose UIDs exist in the /admins/ collection.
     * 3. Authorization Independence: By using document IDs that match Auth UIDs for profiles and 
     *    admins, the rules remain performant and avoid deep, recursive lookups.
     * 4. Structural Segregation: System-wide data is stored in top-level collections for easy 
     *    listing and filtering without complex security-driven query constraints.
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Verifies ownership and ensures the document exists for updates/deletes. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** @description Checks if the user is registered as an administrator. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /** @description Enforces that a field's value does not change during an update. */
    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user-specific profiles. Restricted to the owner.
     */
    match /userProfiles/{userProfileId} {
      allow get: if isOwner(userProfileId);
      allow list: if isOwner(userProfileId);
      allow create: if isOwner(userProfileId) && request.resource.data.id == userProfileId;
      allow update: if isExistingOwner(userProfileId) && isUnchanged('id');
      allow delete: if isExistingOwner(userProfileId);
    }

    /**
     * @description Publicly readable football team data. Managed by admins.
     */
    match /teams/{teamId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    /**
     * @description Publicly readable player master data.
     */
    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Publicly readable league tournament data. Managed by admins.
     */
    match /leagues/{leagueId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
      
      // Seasons and subcollections (matches, leagueTable, coopLeagueTable)
      match /seasons/{seasonId} {
        allow read: if true;
        allow write: if isAdmin();
        
        match /{document=**} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    /**
     * @description Publicly readable cup tournament data. Managed by admins.
     */
    match /cups/{cupId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    /**
     * @description Publicly readable match data (Top-level). Managed by admins.
     */
    match /matches/{matchId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    /**
     * @description Publicly readable notice board data.
     */
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Publicly readable hall of fame data.
     */
    match /hallOfFame/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Publicly readable app configuration (shared password).
     */
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Database Access Control (DBAC) collection defining admin roles.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}