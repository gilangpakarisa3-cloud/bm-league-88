
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // USER DATA: /users/{userId}
    // Users can only access their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // PUBLIC COLLECTIONS: Teams, Players, Notices
    // Allow public read for all.
    // Allow writes only for signed-in users.
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // HALL OF FAME: Public read, writes for signed-in users.
    // This allows listing the collection and getting individual documents.
    match /hallOfFame/{recordId} {
      allow read, write: if isSignedIn();
      allow list: if true;
    }

    // LEAGUES: Nested Collections
    // Public read for all, writes for signed-in users.
    match /leagues/{leagueId} {
        allow read: if true;
        allow write: if isSignedIn();
    }
    match /leagues/{leagueId}/{documents=**} {
        allow read: if true;
        allow write: if isSignedIn();
    }
  }
}
