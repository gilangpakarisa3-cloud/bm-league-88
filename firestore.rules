rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // PUBLIC COLLECTIONS: Teams, Players, Leagues, Seasons, Matches etc.
    // Allow public read for all, but restrict writes.
    // This allows the app to be browsable by anyone.
    // Writes will be handled by more specific rules or admin roles later.
    match /{collection}/{docId} {
        allow read: if true;
        allow write: if false; // Secure by default
    }

    // USER DATA: /users/{userId}
    // Users can only access their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Nested Collections
    match /leagues/{leagueId}/seasons/{seasonId} {
        allow read: if true;
        allow write: if false; // TODO: Implement admin/owner access
    }

    match /leagues/{leagueId}/seasons/{seasonId}/matches/{matchId} {
        allow read: if true;
        allow write: if false; // TODO: Implement admin/owner access
    }

    match /leagues/{leagueId}/seasons/{seasonId}/leagueTable/{leagueEntryId} {
        allow read: if true;
        allow write: if false; // TODO: Implement admin/owner access
    }

    // Explicitly deny access to ambiguous paths
    match /seasons/{seasonId}/{wildcard=**} {
      allow read, write: if false;
    }
  }
}
