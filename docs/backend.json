{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user profile."
        },
        "username": {
          "type": "string",
          "description": "The username of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        }
      },
      "required": [
        "id",
        "username"
      ]
    },
    "Team": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Team",
      "type": "object",
      "description": "Represents a football team.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the team."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL for the team's logo image.",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "Player": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Player",
      "type": "object",
      "description": "Represents a player in the league.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the player."
        },
        "teamId": {
          "type": "string",
          "description": "Reference to the Team the player is associated with."
        },
        "teamName": {
          "type": "string",
          "description": "Denormalized name of the team for easier display."
        },
        "teamLogoUrl": {
          "type": "string",
          "description": "Denormalized URL for the team's logo for easier display."
        }
      },
      "required": [
        "name",
        "teamId",
        "teamName"
      ]
    },
    "League": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "League",
      "type": "object",
      "description": "Represents a league competition.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the league."
        }
      },
      "required": [
        "name"
      ]
    },
    "Cup": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Cup",
      "type": "object",
      "description": "Represents a cup competition.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the cup."
        }
      },
      "required": [
        "name"
      ]
    },
    "Season": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Season",
      "type": "object",
      "description": "Represents a season within a league or cup.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the season (e.g., '2024/25 Season')."
        },
        "status": {
          "type": "string",
          "description": "The current status of the season.",
          "enum": [
            "Not Started",
            "In Progress",
            "Completed"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the season was created."
        }
      },
      "required": [
        "name",
        "status",
        "createdAt"
      ]
    },
    "Match": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Match",
      "type": "object",
      "description": "Represents a match between two players.",
      "properties": {
        "seasonId": {
          "type": "string",
          "description": "Reference to the Season this match belongs to."
        },
        "player1Id": {
          "type": "string",
          "description": "Reference to the first player in the match."
        },
        "player2Id": {
          "type": "string",
          "description": "Reference to the second player in the match."
        },
        "player1Score": {
          "type": "number",
          "description": "The score of the first player."
        },
        "player2Score": {
          "type": "number",
          "description": "The score of the second player."
        },
        "matchDate": {
          "type": "string",
          "description": "The date and time of the match.",
          "format": "date-time"
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Flag indicating if the match has been played."
        },
        "round": {
          "type": "string",
          "description": "For cup matches, the name of the round (e.g., 'Round of 16')."
        },
        "matchNumber": {
          "type": "number",
          "description": "For cup matches, the number of the match within the bracket."
        }
      },
      "required": [
        "seasonId",
        "player1Id",
        "player2Id",
        "matchDate",
        "isCompleted"
      ]
    },
    "LeagueEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LeagueEntry",
      "type": "object",
      "description": "Represents a player's entry in a league table for a season.",
      "properties": {
        "playerId": {
          "type": "string"
        },
        "teamId": {
          "type": "string"
        },
        "playerName": {
          "type": "string"
        },
        "teamName": {
          "type": "string"
        },
        "played": {
          "type": "number"
        },
        "win": {
          "type": "number"
        },
        "draw": {
          "type": "number"
        },
        "loss": {
          "type": "number"
        },
        "goalsFor": {
          "type": "number"
        },
        "goalsAgainst": {
          "type": "number"
        },
        "goalDifference": {
          "type": "number"
        },
        "points": {
          "type": "number"
        }
      }
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores user profile information."
        }
      },
      {
        "path": "/teams/{teamId}",
        "definition": {
          "entityName": "Team",
          "schema": {
            "$ref": "#/backend/entities/Team"
          },
          "description": "Stores all team information."
        }
      },
      {
        "path": "/players/{playerId}",
        "definition": {
          "entityName": "Player",
          "schema": {
            "$ref": "#/backend/entities/Player"
          },
          "description": "Stores all player information."
        }
      },
      {
        "path": "/leagues/{leagueId}",
        "definition": {
          "entityName": "League",
          "schema": {
            "$ref": "#/backend/entities/League"
          },
          "description": "Stores information about different leagues."
        }
      },
      {
        "path": "/leagues/{leagueId}/seasons/{seasonId}",
        "definition": {
          "entityName": "Season",
          "schema": {
            "$ref": "#/backend/entities/Season"
          },
          "description": "Stores season information for a specific league."
        }
      },
      {
        "path": "/leagues/{leagueId}/seasons/{seasonId}/matches/{matchId}",
        "definition": {
          "entityName": "Match",
          "schema": {
            "$ref": "#/backend/entities/Match"
          },
          "description": "Stores all matches for a given season of a league."
        }
      },
      {
        "path": "/leagues/{leagueId}/seasons/{seasonId}/leagueTable/{leagueEntryId}",
        "definition": {
          "entityName": "LeagueEntry",
          "schema": {
            "$ref": "#/backend/entities/LeagueEntry"
          },
          "description": "Stores the league table for a given season of a league."
        }
      },
      {
        "path": "/cups/{cupId}",
        "definition": {
          "entityName": "Cup",
          "schema": {
            "$ref": "#/backend/entities/Cup"
          },
          "description": "Stores information about different cups."
        }
      },
      {
        "path": "/cups/{cupId}/seasons/{seasonId}",
        "definition": {
          "entityName": "Season",
          "schema": {
            "$ref": "#/backend/entities/Season"
          },
          "description": "Stores season information for a specific cup."
        }
      },
      {
        "path": "/cups/{cupId}/seasons/{seasonId}/matches/{matchId}",
        "definition": {
          "entityName": "Match",
          "schema": {
            "$ref": "#/backend/entities/Match"
          },
          "description": "Stores all matches for a given season of a cup."
        }
      },
      {
        "path": "/cups/{cupId}/seasons/{seasonId}/cupParticipants/{playerId}",
        "definition": {
          "entityName": "Player",
          "schema": {
            "$ref": "#/backend/entities/Player"
          },
          "description": "Stores the players participating in a given season of a cup."
        }
      }
    ]
  }
}
