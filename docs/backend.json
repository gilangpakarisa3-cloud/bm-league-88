
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user profile."
        },
        "username": {
          "type": "string",
          "description": "The username of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        }
      },
      "required": [
        "id",
        "username"
      ]
    },
    "Team": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Team",
      "type": "object",
      "description": "Represents a football team.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the team."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL for the team's logo image.",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "Player": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Player",
      "type": "object",
      "description": "Represents a player in the league, including their overall career stats.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the player."
        },
        "teamId": {
          "type": "string",
          "description": "Reference to the Team the player is associated with."
        },
        "teamName": {
          "type": "string",
          "description": "Denormalized name of the team for easier display."
        },
        "overallPlayed": {
          "type": "number",
          "description": "Total matches played across all seasons."
        },
        "overallWin": {
          "type": "number",
          "description": "Total matches won across all seasons."
        },
        "overallDraw": {
          "type": "number",
          "description": "Total matches drawn across all seasons."
        },
        "overallLoss": {
          "type": "number",
          "description": "Total matches lost across all seasons."
        },
        "overallGoalsFor": {
          "type": "number",
          "description": "Total goals scored by the player across all seasons."
        },
        "overallGoalsAgainst": {
          "type": "number",
          "description": "Total goals conceded by the player across all seasons."
        }
      },
      "required": [
        "name",
        "overallPlayed",
        "overallWin",
        "overallDraw",
        "overallLoss",
        "overallGoalsFor",
        "overallGoalsAgainst"
      ]
    },
    "League": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "League",
      "type": "object",
      "description": "Represents a league competition.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the league."
        }
      },
      "required": [
        "name"
      ]
    },
    "Season": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Season",
      "type": "object",
      "description": "Represents a season within a league or cup.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the season (e.g., '2024/25 Season')."
        },
        "status": {
          "type": "string",
          "description": "The current status of the season.",
          "enum": [
            "Not Started",
            "In Progress",
            "Completed"
          ]
        },
        "type": {
            "type": "string",
            "description": "The format of the league for this season.",
            "enum": ["Single", "Co-Op"],
            "default": "Single"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the season was created."
        },
        "startDate": {
            "type": "string",
            "format": "date-time",
            "description": "The start date of the season."
        },
        "endDate": {
            "type": "string",
            "format": "date-time",
            "description": "The end date of the season."
        },
        "registrationFee": {
          "type": "number",
          "description": "The registration fee for this season."
        },
        "sponsorshipAmount": {
          "type": "number",
          "description": "The sponsorship amount for this season."
        }
      },
      "required": [
        "name",
        "status",
        "createdAt",
        "type"
      ]
    },
    "Match": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Match",
      "type": "object",
      "description": "Represents a match between two players or two co-op teams.",
      "properties": {
        "seasonId": {
          "type": "string",
          "description": "Reference to the Season this match belongs to."
        },
        "player1Id": {
          "type": "string",
          "description": "Reference to the first player or co-op team in the match."
        },
        "player2Id": {
          "type": "string",
          "description": "Reference to the second player or co-op team in the match."
        },
        "player1Score": {
          "type": "number",
          "description": "The score of the first player/team."
        },
        "player2Score": {
          "type": "number",
          "description": "The score of the second player/team."
        },
        "matchDate": {
          "type": "string",
          "description": "The date of the match.",
          "format": "date-time"
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Flag indicating if the match has been played."
        }
      },
      "required": [
        "seasonId",
        "player1Id",
        "player2Id",
        "matchDate",
        "isCompleted"
      ]
    },
    "LeagueEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LeagueEntry",
      "type": "object",
      "description": "Represents a player's entry in a league table for a season.",
      "properties": {
        "playerId": {
          "type": "string"
        },
        "teamId": {
          "type": "string"
        },
        "playerName": {
          "type": "string"
        },
        "teamName": {
          "type": "string"
        },
        "played": {
          "type": "number"
        },
        "win": {
          "type": "number"
        },
        "draw": {
          "type": "number"
        },
        "loss": {
          "type": "number"
        },
        "goalsFor": {
          "type": "number"
        },
        "goalsAgainst": {
          "type": "number"
        },
        "goalDifference": {
          "type": "number"
        },
        "points": {
          "type": "number"
        },
        "hasPaid": {
          "type": "boolean",
          "description": "Indicates if the player has paid the registration fee for the season."
        }
      }
    },
    "CoOpLeagueEntry": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "CoOpLeagueEntry",
        "type": "object",
        "description": "Represents a paired team's entry in a Co-Op league table.",
        "properties": {
            "teamName": {"type": "string"},
            "player1Id": {"type": "string"},
            "player1Name": {"type": "string"},
            "player1TeamId": {"type": "string"},
            "player1TeamName": {"type": "string"},
            "player2Id": {"type": "string"},
            "player2Name": {"type": "string"},
            "player2TeamId": {"type": "string"},
            "player2TeamName": {"type": "string"},
            "played": {"type": "number"},
            "win": {"type": "number"},
            "draw": {"type": "number"},
            "loss": {"type": "number"},
            "goalsFor": {"type": "number"},
            "goalsAgainst": {"type": "number"},
            "goalDifference": {"type": "number"},
            "points": {"type": "number"}
        },
        "required": ["teamName", "player1Id", "player1Name", "player2Id", "player2Name", "played", "win", "draw", "loss", "goalsFor", "goalsAgainst", "goalDifference", "points"]
    },
    "Notice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Notice",
      "type": "object",
      "description": "Represents the editable content on the homepage notice board.",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "An array of strings, where each string is a rule."
        },
        "schedule": {
          "type": "string",
          "description": "A string containing the schedule information."
        }
      },
      "required": [
        "rules",
        "schedule"
      ]
    },
    "SeasonRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SeasonRecord",
      "type": "object",
      "description": "A record of a completed season for the Hall of Fame.",
      "properties": {
        "seasonId": { "type": "string" },
        "seasonName": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "winnerPlayerId": { "type": "string" },
        "winnerPlayerName": { "type": "string" },
        "winnerTeamName": { "type": "string" },
        "winnerPhotoUrl": { "type": "string", "format": "uri" },
        "winnerStats": {
          "type": "object",
          "properties": {
            "points": { "type": "number" },
            "win": { "type": "number" },
            "draw": { "type": "number" },
            "loss": { "type": "number" },
            "goalsFor": { "type": "number" },
            "goalsAgainst": { "type": "number" },
            "goalDifference": { "type": "number" }
          }
        },
        "funStats": {
          "type": "object",
          "properties": {
            "bestAttacker": {
              "type": ["object", "null"],
              "properties": {
                "playerName": { "type": "string" },
                "value": { "type": "number" }
              }
            },
            "worstDefender": {
               "type": ["object", "null"],
               "properties": {
                "playerName": { "type": "string" },
                "value": { "type": "number" }
              }
            },
            "mostWins": {
              "type": ["object", "null"],
              "properties": {
                "playerName": { "type": "string" },
                "value": { "type": "number" }
              }
            }
          }
        }
      },
      "required": ["seasonId", "seasonName", "completedAt", "winnerPlayerId", "winnerPlayerName", "winnerTeamName", "winnerStats", "funStats"]
    },
    "AdminConfig": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "AdminConfig",
        "type": "object",
        "description": "Stores global application configuration like the admin password.",
        "properties": {
            "password": {
            "type": "string",
            "description": "The admin password for the application."
            }
        },
        "required": ["password"]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores user profile information."
        }
      },
      {
        "path": "/teams/{teamId}",
        "definition": {
          "entityName": "Team",
          "schema": {
            "$ref": "#/backend/entities/Team"
          },
          "description": "Stores all team information."
        }
      },
      {
        "path": "/players/{playerId}",
        "definition": {
          "entityName": "Player",
          "schema": {
            "$ref": "#/backend/entities/Player"
          },
          "description": "Stores all player information, including their overall career stats."
        }
      },
      {
        "path": "/leagues/{leagueId}",
        "definition": {
          "entityName": "League",
          "schema": {
            "$ref": "#/backend/entities/League"
          },
          "description": "Stores information about different leagues."
        }
      },
      {
        "path": "/leagues/{leagueId}/seasons/{seasonId}",
        "definition": {
          "entityName": "Season",
          "schema": {
            "$ref": "#/backend/entities/Season"
          },
          "description": "Stores season information for a specific league."
        }
      },
      {
        "path": "/leagues/{leagueId}/seasons/{seasonId}/matches/{matchId}",
        "definition": {
          "entityName": "Match",
          "schema": {
            "$ref": "#/backend/entities/Match"
          },
          "description": "Stores all matches for a given season of a league."
        }
      },
      {
        "path": "/leagues/{leagueId}/seasons/{seasonId}/leagueTable/{leagueEntryId}",
        "definition": {
          "entityName": "LeagueEntry",
          "schema": {
            "$ref": "#/backend/entities/LeagueEntry"
          },
          "description": "Stores the league table for a given season of a league."
        }
      },
       {
        "path": "/leagues/{leagueId}/seasons/{seasonId}/coopLeagueTable/{coopLeagueEntryId}",
        "definition": {
          "entityName": "CoOpLeagueEntry",
          "schema": {
            "$ref": "#/backend/entities/CoOpLeagueEntry"
          },
          "description": "Stores the league table for a Co-Op season."
        }
      },
       {
        "path": "/notices/main",
        "definition": {
          "entityName": "Notice",
          "schema": {
            "$ref": "#/backend/entities/Notice"
          },
          "description": "Stores the content for the homepage notice board. This is a singleton document."
        }
      },
      {
        "path": "/hallOfFame/{recordId}",
        "definition": {
          "entityName": "SeasonRecord",
          "schema": {
            "$ref": "#/backend/entities/SeasonRecord"
          },
          "description": "Stores a summary of a completed season for the Hall of Fame."
        }
      },
      {
        "path": "/appConfig/admin",
        "definition": {
          "entityName": "AdminConfig",
          "schema": {
            "$ref": "#/backend/entities/AdminConfig"
          },
          "description": "Stores the admin password as a singleton document."
        }
      }
    ]
  }
}
