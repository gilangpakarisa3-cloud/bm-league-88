rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- PROTOTYPE ACCESS CONTROL ---
    // Aplikasi ini menggunakan model "Shared Password" yang diimplementasikan di UI.
    // Untuk mendukung hal ini, kita mengizinkan akses baca dan tulis publik ke semua koleksi.
    // Catatan: Dalam aplikasi produksi, Anda harus menggunakan request.auth untuk keamanan granular.

    match /{document=**} {
      allow read, write: if true;
    }
    
    /**
     * @description Memicu pembaruan deployment aturan keamanan.
     * System integrity: ACTIVE
     * Prototype mode: ENABLED
     * Last Updated: GD_TRACKING_SYNC_COOP_V2
     */
  }
}
