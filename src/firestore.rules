rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // USER DATA: /users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // PUBLIC ACCESS FOR PROTOTYPE
    // Mengizinkan akses baca dan tulis publik untuk mendukung model Shared Password di UI.
    // Hal ini memungkinkan pengguna yang sudah memasukkan sandi admin di aplikasi untuk menulis ke database.
    
    match /teams/{teamId} {
      allow read, write: if true;
    }

    match /players/{playerId} {
      allow read, write: if true;
    }

    // Koleksi liga, musim, dan pertandingan
    match /leagues/{leagueId}/{documents=**} {
        allow read, write: if true;
    }

    // Papan pengumuman
    match /notices/{document=**} {
      allow read, write: if true;
    }

    // Catatan juara
    match /hallOfFame/{document=**} {
      allow read, write: if true;
    }

    // Konfigurasi aplikasi (termasuk kata sandi admin)
    match /appConfig/{document=**} {
      allow read, write: if true;
    }
    
    // Catch-all untuk mendukung sub-koleksi dinamis lainnya
    match /{path=**} {
      allow read, write: if true;
    }
  }
}